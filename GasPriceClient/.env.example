# Public API origin for native iOS and Android builds. Do not put secrets in
# EXPO_PUBLIC_* variables. Web requests intentionally remain same-origin.
EXPO_PUBLIC_API_URL=https://gasprice-api-proxy.aarondevgame.workers.dev

# Google Maps: put actual values in ignored .env.local or the build service environment.
# Use separate keys restricted to each platform and the corresponding enabled API.
# The web key is public JavaScript configuration; all SDK keys are client-visible.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Choose your actual registered native app identifiers before creating builds.
ANDROID_APPLICATION_ID=
IOS_BUNDLE_IDENTIFIER=
