https://localhost:8443 {
	tls internal

	@api path /auth/* /player/* /fuel-prices /fuel-prices/* /ai/*
	handle @api {
		header {
			Cache-Control "no-store"
			Pragma "no-cache"
		}

		reverse_proxy https://gaspricebackend.onrender.com {
			# Render routes and validates Origin against its own upstream hostname.
			# The browser still sees only the same-origin localhost URL, while
			# Sec-Fetch-Site and the antiforgery cookie/token remain enforced.
			header_up Host gaspricebackend.onrender.com
			header_up Origin https://gaspricebackend.onrender.com
		}
	}

	# Expo/Metro serves the web application and its development websocket.
	handle {
		reverse_proxy 127.0.0.1:8081
	}
}
